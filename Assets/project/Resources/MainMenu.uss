/* =========================================================================
   VR Planetary Rover Digital Twin Simulation Studio
   Professional Main Menu Stylesheet (Aerospace Sci-Fi Unified Theme)
   Follows STYLE reference:
   - Deep tactical charcoal/near-black backplates
   - 1px hairline cyber cyan outlines
   - Bright cyan active cards and radio dots
   - Technical typography with high-contrast text
   ========================================================================= */

.menu-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: #020A1473;
    align-items: center;
    justify-content: center;
    padding: 16px 20px;
}

/* Main Architectural Container Window */
.menu-window {
    width: 980px;
    max-width: 96%;
    background-color: #041222E0;
    border-color: #00E5FF73;
    border-top-color: #00F5FF;
    border-top-width: 2px;
    border-left-color: #00E5FFA6;
    border-left-width: 2px;
    border-width: 1px;
    border-radius: 6px;
    padding: 24px 36px;
    flex-direction: column;
    flex-shrink: 0;
}

/* 1. Header Section */
.menu-header {
    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
}

.header-pre-title {
    font-size: 11px;
    font-style: bold;
    color: #64748B;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.header-title {
    font-size: 28px;
    font-style: bold;
    color: #F8FAFC;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.header-subtitle {
    font-size: 13px;
    font-style: bold;
    color: #00E5FF;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.header-desc {
    font-size: 13px;
    color: #94A3B8;
    line-height: 18px;
    white-space: normal;
}

/* Subtle Hairline Dividers */
.menu-divider {
    height: 1px;
    background-color: #00B4D833;
    margin-top: 14px;
    margin-bottom: 14px;
    flex-shrink: 0;
}

/* 2. Primary Decision: Mode Selection Section */
.mode-section {
    flex-direction: column;
    flex-shrink: 0;
}

.section-title-row {
    flex-direction: row;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.section-title {
    font-size: 12px;
    font-style: bold;
    color: #E2E8F0;
    letter-spacing: 1.5px;
    flex-shrink: 0;
}

.section-caption {
    font-size: 12px;
    color: #64748B;
    white-space: normal;
    flex-shrink: 1;
}

.mode-cards-container {
    flex-direction: row;
    gap: 16px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

/* Native-feel Decision Cards */
.mode-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    background-color: #081C34A6;
    border-color: #00E5FF59;
    border-left-color: #00E5FF73;
    border-left-width: 2px;
    border-width: 1px;
    border-radius: 6px;
    padding: 14px 18px;
    flex-direction: column;
    cursor: link;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.mode-card:hover {
    background-color: #0C2A48CC;
    border-color: #00E5FF;
    border-left-color: #00E5FF;
}

/* Selected state: Elevated contrast with refined cyan accent border */
.mode-card-active {
    background-color: #00E5FF38;
    border-color: #00E5FF;
    border-left-color: #00E5FF;
    border-left-width: 3px;
    border-width: 1px;
}

.mode-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 0;
}

/* Radio Indicator Circle */
.mode-indicator {
    width: 14px;
    height: 14px;
    border-color: #475569;
    border-width: 1.5px;
    border-radius: 7px;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}

.mode-card-active .mode-indicator {
    border-color: #00E5FF;
}

.mode-radio-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: transparent;
}

.mode-card-active .mode-radio-dot {
    background-color: #00E5FF;
}

.mode-card-title {
    font-size: 14px;
    font-style: bold;
    color: #F8FAFC;
    letter-spacing: 0.5px;
    white-space: nowrap;
    flex-shrink: 0;
}

.spacer {
    flex-grow: 1;
}

/* Subtle Badges */
.tag-runtime {
    font-size: 10px;
    color: #94A3B8;
    background-color: #101A29;
    border-color: #00B4D840;
    border-width: 1px;
    padding: 2px 7px;
    border-radius: 4px;
    margin-right: 6px;
    white-space: nowrap;
    flex-shrink: 0;
}

.tag-recommended {
    font-size: 10px;
    font-style: bold;
    color: #00E5FF;
    background-color: #00E5FF1F;
    border-color: #00E5FF;
    border-width: 1px;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    white-space: nowrap;
    flex-shrink: 0;
}

.tag-standard {
    font-size: 10px;
    font-style: bold;
    color: #E2E8F0;
    background-color: #94A3B81A;
    border-color: #00B4D840;
    border-width: 1px;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    white-space: nowrap;
    flex-shrink: 0;
}

.mode-card-body {
    font-size: 12px;
    color: #94A3B8;
    line-height: 17px;
    margin-bottom: 10px;
    white-space: normal;
}

.mode-card-footer {
    border-top-width: 1px;
    border-color: #00B4D833;
    padding-top: 8px;
    margin-top: auto;
    flex-shrink: 0;
}

.mode-meta {
    font-size: 11px;
    color: #64748B;
    white-space: normal;
}

/* 5. Setting Row below selector */
.runtime-setting-row {
    flex-direction: row;
    align-items: center;
    background-color: #081C34A6;
    border-color: #00E5FF59;
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 14px;
    flex-shrink: 0;
}

.runtime-toggle {
    font-size: 13px;
    color: #CBD5E1;
}

.status-pill {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
}

.status-caption {
    font-size: 10px;
    font-style: bold;
    color: #64748B;
    letter-spacing: 1px;
    white-space: nowrap;
}

.status-value {
    font-size: 11px;
    font-style: bold;
    color: #00E5FF;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

/* 6. Supporting Information: Overview Grid */
.overview-section {
    flex-direction: column;
    flex-shrink: 0;
}

.overview-grid {
    flex-direction: row;
    gap: 16px;
    margin-top: 8px;
    flex-shrink: 0;
}

.overview-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    background-color: #081C34A6;
    border-color: #00E5FF59;
    border-left-color: #00E5FF73;
    border-left-width: 2px;
    border-width: 1px;
    border-radius: 5px;
    padding: 10px 14px;
    flex-direction: column;
}

.col-title {
    font-size: 11px;
    font-style: bold;
    color: #94A3B8;
    letter-spacing: 1px;
    margin-bottom: 6px;
    white-space: nowrap;
    flex-shrink: 0;
}

.col-item {
    font-size: 11px;
    color: #CBD5E1;
    line-height: 16px;
    margin-bottom: 4px;
    white-space: normal;
}

/* 7. Bottom Action Footer */
.menu-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    flex-shrink: 0;
}

/* Primary Action CTA Button: Most Obvious on Screen */
.btn-primary-launch {
    background-color: #00E5FF;
    border-width: 0;
    border-radius: 4px;
    padding: 11px 40px;
    cursor: link;
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.15s;
    flex-shrink: 0;
}

.btn-primary-launch:hover {
    background-color: #38BDF8;
}

.btn-primary-launch:active {
    background-color: #00B4D8;
}

.btn-primary-text {
    color: #041222;
    font-size: 14px;
    font-style: bold;
    letter-spacing: 1.5px;
    white-space: nowrap;
}

/* Secondary Action: Quiet and Restrained */
.btn-secondary-exit {
    background-color: #061A3099;
    border-color: #00E5FF66;
    border-width: 1px;
    border-radius: 4px;
    padding: 9px 20px;
    cursor: link;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
    flex-shrink: 0;
}

.btn-secondary-exit:hover {
    background-color: #0C2A48D9;
    border-color: #00E5FF;
}

.btn-secondary-text {
    color: #80DEEA;
    font-size: 13px;
    letter-spacing: 0.5px;
    white-space: nowrap;
}
